<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <!-- 折叠状态 - 小圆点 -->
    <LinearLayout
        android:id="@+id/overlay_collapsed"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:visibility="gone"
        android:background="@drawable/bg_overlay_collapsed"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_shield"
            android:contentDescription="哨兵" />

        <TextView
            android:id="@+id/overlay_probability_collapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <!-- 展开状态 - 完整悬浮窗 -->
    <LinearLayout
        android:id="@+id/overlay_expanded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/bg_overlay_expanded"
        android:elevation="8dp">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_shield"
                android:contentDescription="哨兵" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="哨兵"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/overlay_probability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="12sp"
                android:textColor="#4CAF50"
                android:layout_marginStart="8dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/overlay_toggle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_minimize"
                android:background="@android:color/transparent"
                android:contentDescription="折叠" />

            <ImageButton
                android:id="@+id/overlay_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                android:background="@android:color/transparent"
                android:contentDescription="关闭" />

        </LinearLayout>

        <!-- 概率条 -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_probability_bar">

            <View
                android:id="@+id/overlay_probability_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="#4CAF50" />

        </FrameLayout>

        <!-- 实时识别文本 -->
        <TextView
            android:id="@+id/overlay_transcript"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@android:color/white"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- 检测到的关键词 -->
        <TextView
            android:id="@+id/overlay_keywords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#FF9800"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

        <!-- 提问提示 -->
        <TextView
            android:id="@+id/overlay_question_alert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ 检测到提问"
            android:textSize="12sp"
            android:textColor="#FFD54F"
            android:textStyle="bold"
            android:background="#1B5E20"
            android:padding="4dp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>